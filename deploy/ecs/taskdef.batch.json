{
  "family": "datavigil-batch",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "{{EXECUTION_ROLE_ARN}}",
  "taskRoleArn": "{{TASK_ROLE_ARN}}",
  "containerDefinitions": [
    {
      "name": "datavigil-batch",
      "image": "{{IMAGE_URI}}",
      "essential": true,
      "command": ["batch", "{{MANIFEST_CONTAINER_PATH}}"],
      "environment": [
        { "name": "DATAVIGIL_HOME", "value": "/data" },
        { "name": "AWS_REGION", "value": "{{REGION}}" }
      ],
      "mountPoints": [
        { "sourceVolume": "dvstate", "containerPath": "/data", "readOnly": false }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "{{LOG_GROUP}}",
          "awslogs-region": "{{REGION}}",
          "awslogs-stream-prefix": "batch"
        }
      }
    }
  ],
  "volumes": [
    {
      "name": "dvstate",
      "efsVolumeConfiguration": {
        "fileSystemId": "{{EFS_ID}}",
        "rootDirectory": "/",
        "transitEncryption": "ENABLED"
      }
    }
  ]
}
